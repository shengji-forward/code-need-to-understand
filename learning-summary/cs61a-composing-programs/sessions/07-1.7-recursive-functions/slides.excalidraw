      "versionNonce": 17076,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "function factorial(n) {\n  if (n === 1) return 1;\n  return n * factorial(n - 1);\n}",
      "fontSize": 23,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function factorial(n) {\n  if (n === 1) return 1;\n  return n * factorial(n - 1);\n}",
      "lineHeight": 1.25,
      "baseline": 97
    },
    {
